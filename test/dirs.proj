<Project Sdk="Microsoft.Build.Traversal">
  <ItemGroup>
    <ProjectReference Include="Benchmarks\Benchmarks.csproj" Publish="false" />
    <ProjectReference Include="Nerdbank.MessagePack.Analyzers.Tests\Nerdbank.MessagePack.Analyzers.Tests.csproj" Publish="false" />
    <ProjectReference Include="Nerdbank.MessagePack.SignalR.Tests\Nerdbank.MessagePack.SignalR.Tests.csproj" Publish="false" />
    <ProjectReference Include="Nerdbank.MessagePack.AspNetCoreMvcFormatter.Tests\Nerdbank.MessagePack.AspNetCoreMvcFormatter.Tests.csproj" Publish="false" />
    <ProjectReference Include="Nerdbank.MessagePack.Godot.Tests\Nerdbank.MessagePack.Godot.Tests.csproj" Publish="false" />

    <MultiRIDProjectReference Include="AotCompatibilityTest\AotCompatibilityTest.csproj" />
    <MultiRIDProjectReference Include="AotNativeConsole\AotNativeConsole.csproj" />

    <!-- We want to build all target frameworks of the TUnit project,
         and also *publish* each individual target framework of the TUnit project. -->
    <MultiRIDProjectReference Include="Nerdbank.MessagePack.TUnit\Nerdbank.MessagePack.TUnit.csproj" Publish="false" />
    <MultiRIDProjectReference Include="Nerdbank.MessagePack.TUnit\Nerdbank.MessagePack.TUnit.csproj" TargetFramework="net10.0" AdditionalProperties="NativeAOT=true" />
    <MultiRIDProjectReference Include="Nerdbank.MessagePack.TUnit\Nerdbank.MessagePack.TUnit.csproj" TargetFramework="net11.0" AdditionalProperties="NativeAOT=true" />
  </ItemGroup>
</Project>
