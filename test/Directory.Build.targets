<?xml version="1.0" encoding="utf-8"?>
<Project>
  <Import Project="AOT.props"
          Condition="'$(IsTestProject)' == 'true' and '$(PublishNativeAOTTests)' == 'true' and '$(TargetFramework)' != '' and $([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))" />

  <PropertyGroup Condition="'$(NativeAOT)' == 'true' and '$(PublishNativeAOTTests)' == 'true'">
    <NoWarn>$(NoWarn);IL2104;IL3053</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsTestProject)' != 'false'">
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="Microsoft.Testing.Extensions.CrashDump" />
    <PackageReference Include="Microsoft.Testing.Extensions.HangDump" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
  </ItemGroup>
  <Import Project="$([MSBuild]::GetPathOfFileAbove($(MSBuildThisFile), $(MSBuildThisFileDirectory)..))" />

  <Target Name="GetNativeAOTTestVariants" Returns="@(_NativeAOTTest)"
          Condition="'$(IsTestProject)' == 'true' and '$(PublishNativeAOTTests)' == 'true'">
    <ItemGroup Condition="'$(TargetFramework)' == ''">
      <_TestFramework Include="$(TargetFrameworks)" />
    </ItemGroup>
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="GetNativeAOTTestVariants"
             Properties="TargetFramework=%(_TestFramework.Identity)"
             Condition="'$(TargetFramework)' == ''" BuildInParallel="true">
      <Output TaskParameter="TargetOutputs" ItemName="_NativeAOTTest" />
    </MSBuild>
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="GetNativeAOTTestExecutable"
             Properties="NativeAOT=true"
             Condition="'$(TargetFramework)' != '' and $([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">
      <Output TaskParameter="TargetOutputs" ItemName="_NativeAOTTest" />
    </MSBuild>
  </Target>

  <Target Name="GetNativeAOTTestExecutable" Returns="@(_NativeAOTTestExecutable)">
    <PropertyGroup>
      <_NativeExecutableExtension Condition="$([MSBuild]::IsOsPlatform('Windows'))">.exe</_NativeExecutableExtension>
    </PropertyGroup>
    <ItemGroup>
      <_NativeAOTTestExecutable Include="$(MSBuildProjectFullPath)">
        <ProjectName>$(MSBuildProjectName)</ProjectName>
        <TargetFramework>$(TargetFramework)</TargetFramework>
        <ExecutablePath>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(PublishDir)', '$(AssemblyName)$(_NativeExecutableExtension)'))</ExecutablePath>
      </_NativeAOTTestExecutable>
    </ItemGroup>
  </Target>

  <!--
    A project listed as a NestedVersionJsonProject item has its own version.json, which (rather than the repo root's version.json)
    must determine its assembly version. For each one, this records the AssemblyVersion that Nerdbank.GitVersioning computes when
    GitVersionBaseDirectory is that project's own directory as [assembly: AssemblyMetadata("ExpectedAssemblyVersion:<project name>", "<version>")]
    on the test assembly, so a test can compare it with the version that assembly was actually built with.
    GitVersionBaseDirectory is passed as a global property, so a GitVersionBaseDirectory set in a Directory.Build.props
    (which would make the project get the root version.json's version instead) cannot change the expectation.
  -->
  <Target Name="AddNestedVersionJsonAssemblyVersionExpectations" BeforeTargets="GetAssemblyAttributes" Condition="'@(NestedVersionJsonProject)' != ''">
    <MSBuild Projects="@(NestedVersionJsonProject)"
             Targets="GetNBGVAssemblyVersion"
             Properties="GitVersionBaseDirectory=%(NestedVersionJsonProject.RootDir)%(NestedVersionJsonProject.Directory)"
             RemoveProperties="TargetFramework;RuntimeIdentifier">
      <Output TaskParameter="TargetOutputs" ItemName="_NestedVersionJsonAssemblyVersion" />
    </MSBuild>
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>ExpectedAssemblyVersion:$([System.IO.Path]::GetFileNameWithoutExtension('%(_NestedVersionJsonAssemblyVersion.MSBuildSourceProjectFile)'))</_Parameter1>
        <_Parameter2>%(_NestedVersionJsonAssemblyVersion.Identity)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>
</Project>
