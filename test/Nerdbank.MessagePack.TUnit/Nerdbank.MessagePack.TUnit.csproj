<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../AOT.props" Condition="'$(TargetFramework)' != 'net472' and '$(NativeAOT)' == 'true'" />
  <PropertyGroup Condition="'$(NativeAOT)' == 'true'">
    <IntermediateOutputPath>$(BaseIntermediateOutputPath)$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\nativeaot\</IntermediateOutputPath>
    <OutputPath>$(BaseOutputPath)$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\nativeaot\</OutputPath>
    <PublishDir>$(BaseOutputPath)$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\publish\</PublishDir>
  </PropertyGroup>
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <AotMsCodeCoverageInstrumentation>true</AotMsCodeCoverageInstrumentation>
    <InvariantGlobalization>false</InvariantGlobalization>
    <DefineConstants>$(DefineConstants);TUnit</DefineConstants>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!--
      Several third-party dependencies used only by tests (Newtonsoft.Json(.Schema), System.Data (via
      DataSet/DataTable's IXmlSerializable support), FSharp.Core, and the dynamic (DLR) infrastructure in
      Microsoft.CSharp/System.Linq.Expressions) are not trim/AOT safe. We don't rely on the offending members
      ourselves (or we detect and skip at runtime where we do exercise them, e.g. ExpandoObject tests), so we
      suppress the resulting whole-assembly trim/AOT analysis warnings here rather than in each consuming file.
      IL3000 is additionally suppressed because NetArchTest.eNhancedEdition (used only by ArchitectureRules.cs)
      calls Assembly.Location internally, which is a no-op warning under NativeAOT (its assemblies are compiled
      into the native binary) that we do not otherwise rely on.
    -->
    <NoWarn>$(NoWarn);IL2026;IL2104;IL3053;IL3000</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
    <TargetFrameworks>$(TargetFrameworks);net472</TargetFrameworks>
    <RuntimeIdentifiers>$(RuntimeIdentifiers);win-x86</RuntimeIdentifiers>
    <RuntimeIdentifier>$(DefaultRuntimeIdentifier)</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DiffPlex" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.CodeFix.Testing" />
    <PackageReference Include="Microsoft.CodeCoverage.MSBuild" />
    <PackageReference Include="Nerdbank.Streams" />
    <PackageReference Include="NetArchTest.eNhancedEdition" />
    <PackageReference Include="Newtonsoft.Json.Schema" />
    <PackageReference Include="PolyType.TestCases" />
    <PackageReference Include="TUnit.Engine" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)'=='net472'">
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="ResourcesPath">
      <Value>$([System.IO.Path]::Combine('$(MSBuildProjectDirectory)','Resources','KnownGoodSchemas'))</Value>
    </AssemblyMetadata>
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)','net9.0'))">
    <PackageReference Include="xunit.v3.assert.aot" />
  </ItemGroup>
  <ItemGroup Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)','net9.0'))">
    <PackageReference Include="xunit.v3.assert" />
  </ItemGroup>
  <ItemGroup>
    <None Update="MessagePackReaderTests.ReadInt.tt">
      <Generator>TextTemplatingFileGenerator</Generator>
      <LastGenOutput>MessagePackReaderTests.ReadInt.cs</LastGenOutput>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\src\Nerdbank.MessagePack\InternedBuffers.cs" Link="InternedBuffers.cs" />
    <Compile Update="MessagePackReaderTests.ReadInt.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>MessagePackReaderTests.ReadInt.tt</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <Service Include="{508349b6-6b84-4df5-91f0-309beebad82d}" />
  </ItemGroup>

  <Import Project="$(RepoRootPath)test/AnalyzerConsumer.targets" />

  <!--
    Microsoft.CodeCoverage.MSBuild instruments @(IlcCompileInput) and @(IlcReference) in place before
    IlcCompile and restores them afterward. Most of those references are copies in this project's own
    per-target-framework, per-RID output directory, but project references resolve to the referenced
    project's output directory, which is shared. Nerdbank.MessagePack does not target net10.0, so the
    net9.0 and net10.0 publishes of this project both rewrite the same Nerdbank.MessagePack.dll, which the
    other NativeAOT projects and the pack targets are reading at the same time. That corrupts ILC input
    (observed as BadImageFormatException and SIGBUS on macOS, and file locking errors on Windows) and can
    leave an instrumented assembly in a packable location.
    Compile against a private copy of those shared references so the originals are never mutated and the
    AOT publishes can continue to build in parallel.

    This is an elaborate workaround for what IMO is a bug, which I filed at:
    https://dev.azure.com/devdiv/DevDiv/_workitems/edit/3067881
  -->
  <Target Name="PrivatizeCoverageInstrumentationInputs"
          AfterTargets="PrepareForILCompilation"
          BeforeTargets="AotStaticMsCodeCoverageInstrumentation"
          Condition="'$(AotMsCodeCoverageInstrumentation)' == 'true'">
    <PropertyGroup>
      <!-- The package defaults this to a path shared by all target frameworks of this project. -->
      <MsCodeCoverageFileLogPath>$(IntermediateOutputPath)codecoverage.out</MsCodeCoverageFileLogPath>
      <_CoverageInstrumentationDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'coverage-references'))</_CoverageInstrumentationDir>
      <_DotNetHostDir>$([System.IO.Path]::GetDirectoryName('$(DOTNET_HOST_PATH)'))</_DotNetHostDir>
      <_CoverageOutDirFullPath>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(OutDir)'))</_CoverageOutDirFullPath>
    </PropertyGroup>

    <!-- Select only the references that live outside this project's own private output directories.
         %(Identity) must stay unquoted for MSBuild to accept it inside a property function. -->
    <ItemGroup>
      <_CoverageSharedReference Include="@(IlcReference)"
                                Condition="'$([System.String]::Copy(%(Identity)).StartsWith($(NuGetPackageRoot)))' == 'false' and '$([System.String]::Copy(%(Identity)).StartsWith([System.IO.Path]::GetDirectoryName($(DOTNET_HOST_PATH))))' == 'false' and '$([System.String]::Copy(%(Identity)).StartsWith($(_CoverageOutDirFullPath)))' == 'false'" />
      <_CoverageSharedReferenceSymbols Include="@(_CoverageSharedReference->'%(RootDir)%(Directory)%(Filename).pdb')"
                                       Condition="Exists('%(RootDir)%(Directory)%(Filename).pdb')" />
    </ItemGroup>

    <!-- Never skip unchanged files: the copy must start from a pristine, uninstrumented assembly. -->
    <Copy SourceFiles="@(_CoverageSharedReference);@(_CoverageSharedReferenceSymbols)"
          DestinationFolder="$(_CoverageInstrumentationDir)"
          SkipUnchangedFiles="false">
      <Output TaskParameter="CopiedFiles" ItemName="_CoverageSharedReferenceCopy" />
    </Copy>

    <ItemGroup>
      <IlcReference Remove="@(_CoverageSharedReference)" />
      <IlcReference Include="@(_CoverageSharedReferenceCopy)" Condition="'%(Extension)' == '.dll'" />
    </ItemGroup>
  </Target>
</Project>
